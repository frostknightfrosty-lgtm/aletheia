{"health": "ok", "network_used": false, "sub_sources": [{"endpoint": "https://graph.mapillary.com/images", "key_configured": false, "key_env": "MAPILLARY_ACCESS_TOKEN", "kind": "http_api", "source": "mapillary"}, {"endpoint": "https://nominatim.openstreetmap.org/search", "key_configured": false, "key_env": null, "kind": "http_api", "source": "nominatim"}, {"endpoint": "https://stac.dataspace.copernicus.eu/v1/collections/sentinel-2-l2a/items", "key_configured": false, "key_env": null, "kind": "http_api", "source": "copernicus-stac"}, {"binary_present": true, "endpoint": null, "key_configured": false, "key_env": null, "kind": "local_cli", "source": "dfit"}, {"binary_present": true, "endpoint": null, "key_configured": false, "key_env": null, "kind": "local_cli", "source": "steg-analyzer"}, {"detail": "Betaface documents its public betafaceapi.com service as temporarily down. The available product page does not publish a current detection request contract that this adapter can call without guessing an endpoint or credentials.", "endpoint": null, "key_configured": false, "key_env": null, "kind": "dropped", "source": "betaface"}, {"detail": "The reviewed GeoLocator implementations require a prebuilt panorama index and automatic model weight/index acquisition or GPU setup. No pinned, bounded single-image library contract was verified for this Docker batch.", "endpoint": null, "key_configured": false, "key_env": null, "kind": "dropped", "source": "geolocator"}, {"detail": "PicImageSearch documents a wrapper over many third-party reverse-image engines, but no single downstream engine request contract is documented by that engine for this integration. The runner therefore does not select or scrape an undocumented engine endpoint.", "endpoint": null, "key_configured": false, "key_env": null, "kind": "dropped", "source": "pic-image-search"}, {"detail": "pybdshadow requires building geometry and a datetime. The current single-seed CLI supplies neither a building GeoDataFrame nor a documented building-source contract, so it cannot be invoked without inventing inputs or re-querying another adapter.", "endpoint": null, "key_configured": false, "key_env": null, "kind": "dropped", "source": "pybdshadow"}, {"detail": "ShadowFinder requires object height plus shadow length (or sun altitude) and a date/time. The current single-seed CLI provides no safe structured representation for those independent measurements, so it cannot be invoked without inventing inputs.", "endpoint": null, "key_configured": false, "key_env": null, "kind": "dropped", "source": "shadowfinder"}, {"detail": "tracelines documents deployment of its own coverage proxy and fuses Mapillary, KartaView and street-view coverage. It is not a public hosted API, and its Mapillary path would overlap the direct Mapillary source implemented here.", "endpoint": null, "key_configured": false, "key_env": null, "kind": "dropped", "source": "tracelines"}, {"detail": "youtube-geofind calls the YouTube Data API geospatial search. Aletheia already has the youtube-api adapter for that live vendor API, and this batch must not re-query a sub-source already live in another adapter.", "endpoint": null, "key_configured": false, "key_env": null, "kind": "dropped", "source": "youtube-geofind"}]}
