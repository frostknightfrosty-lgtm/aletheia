{"health": "ok", "network_used": false, "sub_sources": [{"endpoint": "https://registry.faa.gov/database/ReleasableAircraft.zip", "key_configured": false, "kind": "public_csv_archive", "source": "faa-aircraft-registration", "usable": true}, {"endpoint": "https://api.openrailwaymap.org/v2/facility", "key_configured": false, "kind": "public_json_api", "source": "openrailwaymap", "usable": true}, {"endpoint": "https://api.planespotters.net/pub/photos", "key_configured": false, "kind": "keyless_json_endpoint", "source": "planespotters", "usable": true}, {"detail": "ERA's official Knowledge Graph coverage page marks ERATV migration as ongoing, so the public SPARQL service is not a verified ERATV data endpoint yet. The ERATV browser interface also uses CAPTCHA after repeated public view/export attempts; the adapter does not automate or bypass that challenge. See https://www.era.europa.eu/cs/node/1665 and https://www.era.europa.eu/system/files/2022-11/eratv_usm_deployment_end-user_support_material_user_manual_nas_en.pdf.", "endpoint": null, "key_configured": false, "kind": "dropped", "source": "eratv", "usable": false}, {"detail": "No official railway asset registry or public endpoint corresponding to the name ERIS was identified in the reviewed ERA sources. The batching plan names ERATV, not ERIS; no endpoint is inferred from the ambiguous acronym. See https://www.era.europa.eu/cs/node/1665.", "endpoint": null, "key_configured": false, "kind": "dropped", "source": "eris", "usable": false}, {"detail": "IMO documents the Ship and Company Particulars module as a public browser search, but no public machine-readable request contract or API was found in the official GISIS material. The adapter does not automate the browser portal or invent a hidden endpoint. See https://www.imo.org/en/mediacentre/pages/whatsnew-1704.aspx and https://gisis.imo.org/Public/Default.aspx.", "endpoint": null, "key_configured": false, "kind": "dropped", "source": "imo-gisis", "usable": false}]}
