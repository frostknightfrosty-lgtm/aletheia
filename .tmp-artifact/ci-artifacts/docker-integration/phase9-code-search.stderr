{"dropped_sub_sources": ["gitlab-search", "publicwww"], "health": "ok", "network_used": false, "sub_sources": [{"credential_configured": false, "credential_env": "DEBIAN_CODE_SEARCH_API_KEY", "detail": "reachability is not tested by --health; no network request is made", "endpoint": "https://codesearch.debian.net/api/v1/search", "kind": "http_api", "source": "debian-code-search", "usable": true}, {"credential_configured": null, "credential_env": null, "detail": "GitLab's own Search API docs state verbatim \"Every call to this API requires authentication.\" (https://docs.gitlab.com/api/search/), and a live probe of GET https://gitlab.com/api/v4/search?scope=blobs&search=test returned HTTP 401. The code-search scope therefore cannot be used without a token, and no token flow is implemented.", "endpoint": null, "kind": "dropped", "source": "gitlab-search", "usable": false}, {"credential_configured": null, "credential_env": null, "detail": "PublicWWW's own API authentication docs state verbatim \"A paid plan is required: without one, every endpoint except / and /v1/account answers 403 plan_required.\" (https://publicwww.com/docs/api/authentication/). A paid-only source is barred by standing rule 4, so it is not implemented. (Its documented base URL is https://api.publicwww.com with an Authorization: Bearer header, recorded for context only.)", "endpoint": null, "kind": "dropped", "source": "publicwww", "usable": false}]}
