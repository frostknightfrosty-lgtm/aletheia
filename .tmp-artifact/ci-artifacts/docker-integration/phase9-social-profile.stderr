{"health": "ok", "network_used": false, "sub_sources": [{"enabled_by_default": true, "requires_key": false, "source": "crosslinked"}, {"enabled_by_default": true, "requires_key": false, "source": "slinky"}, {"enabled_by_default": false, "requires_key": false, "skip_reason": "Upstream collector uses TikTokApi and Playwright, automatically retries headed after errors, and its TikTokApi dependency uses stealth/browser behavior to avoid bot detection. No bounded stable public API contract is used; no CAPTCHA or anti-bot challenge is bypassed. See https://github.com/bellingcat/tiktok-hashtag-analysis/blob/main/tiktok_hashtag_analysis/base.py and https://github.com/davidteather/TikTok-Api/blob/main/TikTokApi/tiktok.py.", "source": "tiktok-hashtag-analysis"}, {"enabled_by_default": false, "requires_key": false, "skip_reason": "Zehef accepts email seeds and combines account-creation endpoint checks with breach/stealer queries, outside this profile adapter's input/output scope. See https://github.com/N0rz3/Zehef/blob/master/modules/accounts/instagram.py and https://github.com/N0rz3/Zehef/blob/master/modules/breaches/hudsonrock.py.", "source": "zehef"}]}
